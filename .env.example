# OSMU Studio 비밀값 — 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올라가지 않는다.
# 필요한 것만 채우면 된다. 비어 있으면 해당 기능은 건너뛴다.

# 알림 (둘 중 하나)
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 이미지 / 음성 (설치 때 고른 서비스만)
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Pixverse 는 `pixverse auth login` 으로 로그인한다. 전역 설치가 아니면 index.js 경로를 적는다.
PIXVERSE_CLI=

# 선택: 유튜브 상위 영상 조회수 기준 리서치
YOUTUBE_API_KEY=
